{
  "sourceLanguage": "ru",
  "strings": {
    "iCloud недоступен или изменился Apple ID. Локальные записи сохранены.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is unavailable or the Apple ID changed. Your entries on this phone are safe."
          }
        }
      }
    },
    "Аккаунт iCloud изменился. Верните прежний Apple ID и перезапустите Folki.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iCloud account changed. Sign back in with the previous Apple ID and restart Folki."
          }
        }
      }
    },
